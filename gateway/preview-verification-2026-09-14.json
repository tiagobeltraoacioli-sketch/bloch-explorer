        "absent": [
          {
            "name": "gettransaction",
            "why": "the node routes this to a permanent NO_TRANSACTION_INDEX refusal, so forwarding it would spend an upstream call to be told so. Note that the node's own refusal text says a transaction \"carries no id\", and that is not true: consensus computes txid = SHA3-256(DS_TXID || spend_signing_root) over the witness-free root (PosTransaction::txid, bloch-pos-committee/src/transition.rs). What is missing is the INDEX from that id back to a block \u2014 getblockbyslot reports tx_count and carries no transactions \u2014 so track transfers by outpoint and by balance via getbalance / listunspent, which are exact."
          },
          {
            "name": "getnewaddress",
            "why": "the node routes this to a permanent NO_WALLET refusal. Same reasoning."
          }
        ],
        "corroboration_levels": {
          "final": "at or below the finalised checkpoint, content- or lineage-pinned",
