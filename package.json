{
  "name": "bloch-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Block explorer for Bloch Genesis-4, a post-quantum proof-of-stake chain \u2014 blochl1.com",
  "scripts": {
    "dev": "vite",
    "build": "python3 scripts/render-validator-guide.py && node scripts/check-fees.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npx wrangler pages deploy --project-name bloch-explorer --branch main",
    "test": "node --experimental-strip-types --test \"edge/tests/*.test.mjs\"",
    "test:lab": "node edge/tests/live-lab.mjs",
    "check:fees": "node scripts/check-fees.mjs",
    "verify": "node --experimental-strip-types scripts/verify-address-pages.mjs",
    "test:l2": "node --experimental-strip-types --test edge/tests/l2.test.mjs edge/tests/l2-settled.test.mjs",
    "preview:l2": "node scripts/l2-explorer-preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
